<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>QuickElevate</title>
    <organization>com.quickelevate</organization>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>
    <welcome file="welcome.html"/>
    <choices-outline>
        <line choice="quickelevate.choice"/>
    </choices-outline>
    <choice id="quickelevate.choice" title="QuickElevate" visible="false">
        <pkg-ref id="com.quickelevate.pkg"/>
    </choice>
    <pkg-ref id="com.quickelevate.pkg" version="0.1.0" onConclusion="none">QuickElevate-component.pkg</pkg-ref>
</installer-gui-script>
