<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  QuickElevate entitlements template (local free-signing phase).

  Usage: the installer replaces @APPLE_TEAM_ID@ with the Apple Development
  Personal Team ID, then signs the app using this file as entitlements.

  The keychain group below MUST match MSAL's default macOS cache group
  (com.microsoft.identity.universalstorage). MSAL verifies this entitlement
  at runtime (isAppEntitled); without it every silent/PSSO token request
  fails with OSStatus -34018 ("A required entitlement isn't present").
-->
<plist version="1.0">
<dict>
    <key>keychain-access-groups</key>
    <array>
        <string>@APPLE_TEAM_ID@.com.microsoft.identity.universalstorage</string>
    </array>
</dict>
</plist>
