{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "0.1.0.0",
  "metadata": {
    "description": "QuickElevate private Azure Function pilot infrastructure. Deploy application code and complete Entra/Graph post-deployment steps separately."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region for all regional resources." }
    },
    "environmentName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 12,
      "metadata": { "description": "Short lowercase environment suffix, for example dev, test, or prod." }
    },
    "existingVnetResourceId": {
      "type": "string",
      "metadata": { "description": "Existing VNet resource ID linked to the QuickElevate private DNS zone." }
    },
    "privateEndpointSubnetId": {
      "type": "string",
      "metadata": { "description": "Existing subnet resource ID for the Function App inbound private endpoint. Do not use the Function outbound VNet integration subnet." }
    },
    "tenantId": {
      "type": "string",
      "metadata": { "description": "Microsoft Entra tenant ID allowed to call the authorization API." }
    },
    "pimGroupObjectId": {
      "type": "string",
      "metadata": { "description": "Required immutable object ID of the PIM-managed Entra security group checked by the backend." }
    },
    "membershipMode": {
      "type": "string",
      "defaultValue": "Transitive",
      "allowedValues": ["Direct", "Transitive"],
      "metadata": { "description": "Transitive accepts nested memberships; Direct accepts only direct membership." }
    },
    "defaultElevationSeconds": {
      "type": "int",
      "defaultValue": 60,
      "minValue": 5,
      "maxValue": 300,
      "metadata": { "description": "Default backend-approved elevation duration in seconds." }
    },
    "maximumElevationSeconds": {
      "type": "int",
      "defaultValue": 300,
      "minValue": 5,
      "maxValue": 3600,
      "metadata": { "description": "Absolute backend maximum elevation duration in seconds." }
    },
    "nativeClientId": {
      "type": "string",
      "metadata": { "description": "Microsoft Entra application client ID for the QuickElevate macOS native client." }
    },
    "apiApplicationId": {
      "type": "string",
      "metadata": { "description": "Microsoft Entra application client ID representing the QuickElevate authorization API." }
    },
    "functionAppName": {
      "type": "string",
      "defaultValue": "[concat('func-quickelevate-', toLower(parameters('environmentName')), '-', uniqueString(resourceGroup().id))]",
      "metadata": { "description": "Globally unique Function App name." }
    }
  },
  "variables": {
    "storageName": "[toLower(concat('stqe', uniqueString(resourceGroup().id, parameters('environmentName'))))]",
    "planName": "[concat('plan-quickelevate-', toLower(parameters('environmentName')))]",
    "keyVaultName": "[toLower(concat('kv-qe-', toLower(parameters('environmentName')), '-', uniqueString(resourceGroup().id)))]",
    "appInsightsName": "[concat('appi-quickelevate-', toLower(parameters('environmentName')))]",
    "privateDnsZoneName": "privatelink.azurewebsites.net"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard_LRS" },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "DisableLocalAuth": true
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[parameters('tenantId')]",
        "enableRbacAuthorization": true,
        "enablePurgeProtection": true,
        "enableSoftDelete": true,
        "publicNetworkAccess": "Enabled",
        "sku": { "family": "A", "name": "standard" }
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/keys",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'elevation-grant')]",
      "dependsOn": ["[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"],
      "properties": {
        "kty": "RSA",
        "keySize": 2048,
        "keyOps": ["sign", "verify"],
        "attributes": { "enabled": true }
      }
    },
    {
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2024-06-01",
      "name": "[variables('privateDnsZoneName')]",
      "location": "global"
    },
    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2024-06-01",
      "name": "[format('{0}/{1}', variables('privateDnsZoneName'), 'quickelevate-vnet-link')]",
      "location": "global",
      "dependsOn": ["[resourceId('Microsoft.Network/privateDnsZones', variables('privateDnsZoneName'))]"],
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": { "id": "[parameters('existingVnetResourceId')]" }
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2024-04-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp",
      "sku": { "tier": "FlexConsumption", "name": "FC1" },
      "properties": { "reserved": true }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-04-01",
      "name": "[parameters('functionAppName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp,linux",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": ["[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "publicNetworkAccess": "Disabled",
        "siteConfig": { "minTlsVersion": "1.2", "ftpsState": "Disabled" }
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2024-04-01",
      "name": "[format('{0}/appsettings', parameters('functionAppName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/keys', variables('keyVaultName'), 'elevation-grant')]",
        "[resourceId('Microsoft.Insights/components', variables('appInsightsName'))]"
      ],
      "properties": {
        "FUNCTIONS_EXTENSION_VERSION": "~4",
        "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
        "TENANT_ID": "[parameters('tenantId')]",
        "PIM_GROUP_OBJECT_ID": "[parameters('pimGroupObjectId')]",
        "MEMBERSHIP_MODE": "[parameters('membershipMode')]",
        "DEFAULT_ELEVATION_SECONDS": "[string(parameters('defaultElevationSeconds'))]",
        "MAXIMUM_ELEVATION_SECONDS": "[string(parameters('maximumElevationSeconds'))]",
        "GRANT_ISSUER": "[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2024-04-01').defaultHostName)]",
        "GRANT_AUDIENCE": "com.quickelevate.helper",
        "KEY_VAULT_SIGNING_KEY_ID": "[reference(resourceId('Microsoft.KeyVault/vaults/keys', variables('keyVaultName'), 'elevation-grant'), '2023-07-01').properties.keyUriWithVersion]",
        "APPLICATIONINSIGHTS_CONNECTION_STRING": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').ConnectionString]",
        "QUICK_ELEVATE_NATIVE_CLIENT_ID": "[parameters('nativeClientId')]",
        "QUICK_ELEVATE_API_APPLICATION_ID": "[parameters('apiApplicationId')]"
      }
    },
    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2024-05-01",
      "name": "[concat('pe-', parameters('functionAppName'))]",
      "location": "[parameters('location')]",
      "dependsOn": ["[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]"],
      "properties": {
        "subnet": { "id": "[parameters('privateEndpointSubnetId')]" },
        "privateLinkServiceConnections": [{
          "name": "quickelevate-api",
          "properties": {
            "privateLinkServiceId": "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]",
            "groupIds": ["sites"]
          }
        }]
      }
    },
    {
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2024-05-01",
      "name": "[format('pe-{0}/default', parameters('functionAppName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateEndpoints', concat('pe-', parameters('functionAppName')))]",
        "[resourceId('Microsoft.Network/privateDnsZones', variables('privateDnsZoneName'))]"
      ],
      "properties": {
        "privateDnsZoneConfigs": [{
          "name": "webapps",
          "properties": { "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', variables('privateDnsZoneName'))]" }
        }]
      }
    }
  ],
  "outputs": {
    "apiBaseUrl": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2024-04-01').defaultHostName)]"
    },
    "apiAudience": { "type": "string", "value": "[concat('api://', parameters('apiApplicationId'))]" },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2024-04-01', 'Full').identity.principalId]"
    },
    "requiredGraphPermission": {
      "type": "string",
      "value": "GroupMember.ReadBasic.All (application permission, tenant admin consent required)"
    }
  }
}
